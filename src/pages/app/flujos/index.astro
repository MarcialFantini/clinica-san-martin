---
import AppLayout from '../../../layouts/AppLayout.astro';
import { icon } from '../../../lib/icons';
---

<AppLayout view="flujos" title="Automatizaciones">
  <div data-view-root class="flows-view">
    <header class="page-head">
      <div>
        <h1>Automatizaciones</h1>
        <p>Cada flujo trabaja solo: se dispara con un evento de la clínica, espera, escribe y decide. Apagá uno y mirá qué pasa en la agenda.</p>
      </div>
      <div class="page-actions">
        <a class="btn btn-primary" href="/app/flujos/editor/?nuevo=1"><Fragment set:html={icon('plus')} />Nueva automatización</a>
      </div>
    </header>
    <ul class="flow-list" data-flows>
      {Array.from({ length: 4 }).map(() => <li class="card"><span class="skeleton sk-line" style="width:40%" /><span class="skeleton sk-block" style="height:60px" /></li>)}
    </ul>
  </div>
</AppLayout>

<style is:global>
  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .flow-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
  }
  .flow-card h2 {
    font-size: 20px;
  }
  .flow-card h2 a {
    text-decoration: none;
  }
  .flow-card h2 a:hover {
    text-decoration: underline;
  }
  .flow-card .desc {
    color: var(--ink-2);
    font-size: 15px;
    margin-top: 4px;
  }
  .flow-card .trigger {
    margin-top: 10px;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .flow-stats {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .flow-stats b {
    display: block;
    font-family: var(--font-display);
    font-size: 26px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .flow-stats span {
    font-size: 13px;
    color: var(--ink-3);
  }
  .flow-side {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
  }
  .mini-flow {
    width: 100%;
    height: 64px;
    margin-top: 12px;
  }
  .mini-flow rect {
    fill: var(--surface-2);
  }
  .mini-flow path {
    fill: none;
    stroke: var(--surface-3);
    stroke-width: 6;
  }
  .mini-flow .pulse {
    fill: var(--aqua);
    opacity: 0;
  }
  .mini-flow.off rect {
    fill: var(--surface-2);
    opacity: 0.6;
  }
  .flow-card.off h2,
  .flow-card.off .flow-stats b {
    color: var(--ink-3);
  }
  @media (max-width: 1100px) {
    .flow-card {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .flow-card .mini-wrap {
      grid-column: 1 / -1;
      order: 3;
    }
  }
  @media (max-width: 720px) {
    .flow-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .flow-side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
